{
  "version": "1",
  "cases": [
    {
      "id": "confirmed-count",
      "text": "L'organisation confirme que 42 comptes ont été compromis.",
      "expect": {"count": 42, "status": "confirmed"}
    },
    {
      "id": "claimed-count",
      "text": "Le groupe revendique 12 345 victimes.",
      "expect": {"count": 12345, "status": "claimed"}
    },
    {
      "id": "hypothesis-data-type",
      "text": "Les données pourraient comprendre des adresses e-mail.",
      "expect": {"data_type": "adresses e-mail", "status": "hypothesis"}
    },
    {
      "id": "negation",
      "text": "Les systèmes internes n'ont pas été touchés.",
      "expect": {"status": "negated", "no_confirmed": true}
    },
    {
      "id": "multiple-volumes",
      "text": "Le groupe affirme avoir volé 91,7 Go compressés, soit environ 340 Go après décompression.",
      "expect": {"volumes": [91.7, 340.0], "status": "claimed"}
    },
    {
      "id": "timeline",
      "text": "Le 19 mars 2026, l'intrusion a commencé. Le 27 mars 2026, l'incident a été rendu public.",
      "expect": {"dates": ["2026-03-19", "2026-03-27"]}
    },
    {
      "id": "cve",
      "text": "L'incident mentionne la vulnérabilité CVE-2026-12345.",
      "expect": {"cve": "CVE-2026-12345"}
    },
    {
      "id": "divergence",
      "claims": [
        {"type": "affected_count", "status": "claimed", "value": 200000, "scope": "clients", "source_id": "A", "evidence": "A revendique 200000 clients"},
        {"type": "affected_count", "status": "confirmed", "value": 175000, "scope": "clients", "source_id": "B", "evidence": "B confirme 175000 clients"}
      ],
      "expect": {"primary": 175000, "divergences": 1}
    }
  ]
}
